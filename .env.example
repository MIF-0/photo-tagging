# =====================================================================
# Provider selection
# =====================================================================
# Which vision LLM to use: "gemini" (default) or "groq".
PROVIDER=gemini

# =====================================================================
# Batching
# =====================================================================
# How many images to send to the vision model in a single request.
# The rate-limit delay is applied between batches (not between images).
# Optional. Default: 10.
BATCH_SIZE=10

# =====================================================================
# Video (.mov) frame sampling
# =====================================================================
# .mov clips are tagged by sampling frames with ffmpeg (install via
# `brew install ffmpeg`) and analyzing them together as one clip. VIDEO_FPS
# sets how many frames per second to sample; the total per clip is capped
# internally to avoid oversized requests. Metadata is written as XMP +
# QuickTime tags. Optional. Default: 2.
VIDEO_FPS=2

# =====================================================================
# Gemini  (used when PROVIDER=gemini)
# =====================================================================
GEMINI_API_KEY=your_gemini_key_here
# Delay between API calls in milliseconds.
GEMINI_RATE_LIMIT_MS=2000
# Optional. Default: gemini-3.5-flash-lite (latest low-cost, high-volume tier).
# Other options: gemini-2.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash, ...
GEMINI_MODEL=gemini-3.5-flash-lite

# =====================================================================
# Groq  (used when PROVIDER=groq)
# =====================================================================
GROQ_API_KEY=your_groq_key_here
GROQ_RATE_LIMIT_MS=2000
# Optional. Default: meta-llama/llama-4-scout-17b-16e-instruct.
# See https://console.groq.com/docs/models for the current vision-capable list.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# =====================================================================
# Logging
# =====================================================================
# Optional. Defaults to ./photo_tagger.log in the current working directory.
# The file is truncated on each run.
LOG_FILE=photo_tagger.log

# =====================================================================
# Stock-site extras (Pond5 etc.)
# =====================================================================
# Country is written to IPTC, XMP-photoshop, and XMP-iptcExt schemas.
# Defaults to "United Kingdom".
DEFAULT_COUNTRY=United Kingdom

# Camera make/model are only written if the source file has no camera identity
# yet — genuine EXIF (photos) or QuickTime tags (videos, e.g. an iPhone's
# Apple / iPhone model) are never overwritten.
# Defaults: Panasonic / DC-S5M2X (Lumix S5IIx).
DEFAULT_CAMERA_MAKE=Panasonic
DEFAULT_CAMERA_MODEL=DC-S5M2X
