# =====================================================================
# Batching
# =====================================================================
# How many images to send to the vision model in a single request.
# The rate-limit delay is applied between batches (not between images).
# Optional. Default: 10.
BATCH_SIZE=10

# =====================================================================
# Video (.mov) frame sampling
# =====================================================================
# .mov clips are tagged by sampling frames with ffmpeg (install via
# `brew install ffmpeg`) and analyzing them together as one clip. VIDEO_FPS
# sets how many frames per second to sample; the total per clip is capped
# internally to avoid oversized requests. Metadata is written as XMP +
# QuickTime tags. Optional. Default: 2.
VIDEO_FPS=2

# =====================================================================
# Photo grading & best picks
# =====================================================================
# Each photo is graded 1-10 (editing, technical, commercial cleanliness,
# market demand, overall) in the same call that tags it. Grades are saved to
# GRADES_FILE in the tagged folder after every batch; once all photos are
# tagged, those with overall > BEST_MIN_GRADE are copied into BEST_DIR,
# keeping only the best of each group of near-duplicate shots. GRADES_FILE and
# BEST_DIR are plain names inside the tagged folder, not paths. Videos are not
# graded.
# Optional. Defaults: stock_grades.csv / best_for_stock / 6.
GRADES_FILE=stock_grades.csv
BEST_DIR=best_for_stock
BEST_MIN_GRADE=6
# Max fingerprint distance (bits out of 64) for two photos to count as
# near-duplicates. Lower = stricter. Optional. Default: 10.
SIMILARITY_MAX_DISTANCE=10

# =====================================================================
# Gemini
# =====================================================================
GEMINI_API_KEY=your_gemini_key_here
# Delay between API calls in milliseconds.
GEMINI_RATE_LIMIT_MS=2000
# Optional. Default: gemini-3.8-flash (newest; best keywording and grading judgment).
# Other options: gemini-3.5-flash, gemini-3.5-flash-lite (cheaper), gemini-2.5-flash
# (a good fallback when the 3.x models return 503 "high demand"), ...
GEMINI_MODEL=gemini-3.8-flash

# =====================================================================
# Logging
# =====================================================================
# Optional. Defaults to photo_tagger.log in the tagged folder (next to
# stock_grades.csv). A relative path is taken inside the tagged folder; use an
# absolute path (or ~/...) for one shared log. Each run starts a fresh log that
# opens with the settings it uses (digiKam runs of one queue share a log).
LOG_FILE=photo_tagger.log

# =====================================================================
# Stock-site extras (Pond5 etc.)
# =====================================================================
# Country is written to IPTC, XMP-photoshop, and XMP-iptcExt schemas.
# Defaults to "United Kingdom".
DEFAULT_COUNTRY=United Kingdom

# Camera make/model are only written if the source file has no camera identity
# yet — genuine EXIF (photos) or QuickTime tags (videos, e.g. an iPhone's
# Apple / iPhone model) are never overwritten.
# Defaults: Panasonic / DC-S5M2X (Lumix S5IIx).
DEFAULT_CAMERA_MAKE=Panasonic
DEFAULT_CAMERA_MODEL=DC-S5M2X
